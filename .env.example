# cTrader Open API app credentials — https://openapi.ctrader.com/apps
OPEN_API_CLIENT_ID=your_client_id
OPEN_API_SECRET=your_client_secret

# Must exactly match one of the redirect URIs registered for your app.
# Only http://localhost:<port>/<path> is supported (a local server catches it).
CTRADER_REDIRECT_URI=http://localhost:8899/callback

# Filled in automatically after the first browser login. Never commit them.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_EXPIRES_AT=
